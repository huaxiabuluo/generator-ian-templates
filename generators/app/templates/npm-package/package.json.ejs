{
  "name": "<%= packageName %>",
  "version": "1.0.0",
  "description": "<%= applicationDesc %>",
  "main": "lib/index.js",
  "unpkg": "dist/index.js",
  "module": "es/index.js",
  "typings": "types/index.d.ts",
  "type": "module",
  "scripts": {
    "build:commonjs": "cross-env BABEL_MODULE=commonjs babel src --out-dir lib --extensions '.ts,.tsx'",
    "build:es": "babel src --out-dir es --extensions '.ts,.tsx'",
    "build:umd": "rollup -c",
    "build": "pnpm run build:commonjs && pnpm run build:es && pnpm run types",
    "types": "tsc --emitDeclarationOnly",
    "clean": "rimraf lib/* dist/* es/* types/*",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs}\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["react", "npm", "package", "rollup"],
  "author": {
    "name": "<%= authorName %>",
    "email": "<%= authorEmail %>"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "rollup-plugin-typescript2": "^0.37.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "core-js": "~3.50.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "packageManager": "pnpm@11.5.3"
}
